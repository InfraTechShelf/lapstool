<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    全プロジェクト共通のビルド設定。

    【.NET Framework 4.8 参照アセンブリの解決について】
    開発端末に「.NET Framework 4.8 Developer Pack」が入っていない場合、MSBuild は MSB3644 で
    失敗するため、フォールバックとしてランタイムのアセンブリディレクトリを指定する。
    Developer Pack が入っている端末では Condition が false になり、この上書きは行われない。
  -->
  <PropertyGroup Condition="!Exists('$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8')">
    <FrameworkPathOverride>$(WinDir)\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <!-- 出力を dist/ にまとめ、「フォルダごとコピーすれば動く」形にする -->
    <SolutionRootDir>$(MSBuildThisFileDirectory)</SolutionRootDir>
    <!--
      exe/dll に埋め込まれる pdb のパスやソースパスから、ビルド端末のフォルダ（ユーザー名を含む）を消す。
      公開バイナリにビルドした人の環境情報を残さないため。
    -->
    <PathMap>$(MSBuildThisFileDirectory)=\LapsTool\</PathMap>
  </PropertyGroup>

</Project>
