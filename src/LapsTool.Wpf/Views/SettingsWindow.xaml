<Window x:Class="LapsTool.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Yu Gothic UI" FontSize="13">
    <StackPanel Margin="14">
        <GroupBox Header="リモートデスクトップ接続" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="ローカルアカウント名" Style="{StaticResource Label}" />
                <TextBox Grid.Column="1" Text="{Binding LocalAccountName}" Margin="0,4" Padding="3" />

                <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,4" IsChecked="{Binding PreferLapsAccountName}">
                    <TextBlock TextWrapping="Wrap" Text="Windows LAPS に記録されたアカウント名があればそちらを優先する" />
                </CheckBox>
                <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,4" IsChecked="{Binding ConnectByFqdn}"
                          Content="FQDN（DNS名）で接続する" />
                <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,4" IsChecked="{Binding RdpAdminMode}"
                          Content="管理モード（/admin）で接続する" />

                <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,4" IsChecked="{Binding CopyPasswordOnRdp}"
                          Content="接続時にパスワードをクリップボードにコピーする" />

                <TextBlock Grid.Row="5" Text="クリップボード消去まで（秒）" Style="{StaticResource Label}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ClipboardClearSeconds}" Width="80"
                         HorizontalAlignment="Left" Margin="0,4" Padding="3" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Active Directory" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="ドメインコントローラー（空で自動）" Style="{StaticResource Label}" />
                <TextBox Grid.Column="1" Text="{Binding DomainController}" Margin="0,4" Padding="3" />
                <TextBlock Grid.Row="1" Text="検索ベース DN（空でドメイン全体）" Style="{StaticResource Label}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SearchBase}" Margin="0,4" Padding="3" />
                <TextBlock Grid.Row="2" Text="検索結果の上限（件）" Style="{StaticResource Label}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxSearchResults}" Width="80"
                         HorizontalAlignment="Left" Margin="0,4" Padding="3" />
            </Grid>
        </GroupBox>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="既定値ファイルとして書き出す…" Click="OnExportClick"
                    ToolTip="exe と同じフォルダに置くと、全利用者の初期設定になります" />
            <Button DockPanel.Dock="Right" Content="キャンセル" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Click="OnOkClick" />
        </DockPanel>
    </StackPanel>
</Window>
